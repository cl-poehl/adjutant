# ────────────────────────── Adjutant — backend config ───────────────────────
# Copy to backend/.env (or repo-root .env) and fill in ANTHROPIC_API_KEY.
# Everything else has a working default; uncomment only what you want to change.

# ── Required ────────────────────────────────────────────────────────────────
# Anthropic API key — powers classification, drafting, and all generation.
ANTHROPIC_API_KEY=sk-ant-...

# ── Database ────────────────────────────────────────────────────────────────
# Default is zero-setup SQLite. For Postgres/Supabase, set a URL and run:
#   psql "$DATABASE_URL" -f backend/db/migrations/001_init.sql   (then 002..N in order)
DATABASE_URL=sqlite:///./adjutant.db

# ── Google OAuth (Gmail) ────────────────────────────────────────────────────
# Desktop-type OAuth client downloaded from Google Cloud Console.
# Paths are relative to where you start the backend (backend/).
GOOGLE_CREDENTIALS_PATH=./credentials.json
GOOGLE_TOKEN_PATH=./token.json

# ── Models ──────────────────────────────────────────────────────────────────
# Cheap model for triage, stronger model for drafting/generation.
CLASSIFY_MODEL=claude-haiku-4-5-20251001
DRAFT_MODEL=claude-sonnet-4-6

# ── Sync ────────────────────────────────────────────────────────────────────
SYNC_QUERY=in:inbox newer_than:7d
SYNC_MAX_THREADS=25        # thread-list scan window
SYNC_MAX_MESSAGES=400      # newest-message recency scan (catches deep, freshly-replied threads)
SYNC_INTERVAL_MINUTES=0    # 0 = sync only from the dashboard button; >0 = also poll every N min

# Extra addresses that count as "me" (comma-separated) — e.g. a forwarded
# university account. Affects needs-reply detection and reply targeting.
MY_ALIASES=

# ── Daily agents ────────────────────────────────────────────────────────────
# Default on/off state for each paid daily job (also toggled in Settings → Automations).
# The research brief is the most expensive; leave off until you want it.
RESEARCH_DAILY=false
IDEAS_DAILY=false
JOBS_DAILY=false
IDEAS_PER_DAY=5
JOBS_PER_DAY=6
RESEARCH_BRIEF_HOUR=7      # local hour the morning brief fires
BRIEF_TZ=UTC              # your IANA timezone, e.g. Europe/Berlin, America/New_York
# Free-text preferences that steer the scouts (optional):
# JOB_PREFS=
# EVENT_INTERESTS=

# ── Notifications (optional) ────────────────────────────────────────────────
# Where pushes go: comma-separated among "telegram", "email".
NOTIFY_CHANNELS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_EMAIL=              # address for email pushes (defaults to the account itself)

# ── Frontend / CORS ─────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:3000

# ── Email provider ──────────────────────────────────────────────────────────
EMAIL_PROVIDER=gmail       # "gmail" today; "outlook" is scaffolded

# Outlook (EMAIL_PROVIDER=outlook) — Azure app registration required; see
# backend/providers/outlook.py. University tenants may need admin consent.
OUTLOOK_CLIENT_ID=
OUTLOOK_TENANT_ID=organizations
OUTLOOK_TOKEN_PATH=./outlook_token.json
